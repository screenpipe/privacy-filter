# screenpipe — AI that knows everything you've seen, said, or heard
# https://screenpipe.com
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PRIVACY_ONLY=true ORT_NUM_THREADS=4 IMAGE_MAX_CONCURRENCY=2 PORT=8080 HOME=/home/appuser
WORKDIR /app
COPY requirements.cpu.txt /app/requirements.cpu.txt
RUN pip install --no-cache-dir -r requirements.cpu.txt
ARG SOURCE_MODEL_ID=screenpipe/pii-redactor
ARG SOURCE_MODEL_REVISION=c6421b1beb13d6014632f6d498c81113bee57cbd
ARG SOURCE_MODEL_SUBFOLDER=v52_multilingual_sensitive_int8
ARG SOURCE_MODEL_BASE_URL=https://raw.githubusercontent.com/screenpipe/privacy-filter/${SOURCE_MODEL_REVISION}/${SOURCE_MODEL_SUBFOLDER}
ENV MODEL_DIR=/opt/model \
    MODEL_ID="screenpipe/pii-redactor:v52_multilingual_sensitive_int8 (qint8-onnx)"
COPY build_download.py /tmp/build_download.py
RUN useradd --system --no-create-home --uid 10001 appuser \
    && SOURCE_MODEL_BASE_URL=$SOURCE_MODEL_BASE_URL \
       SOURCE_MODEL_ID=$SOURCE_MODEL_ID \
       SOURCE_MODEL_REVISION=$SOURCE_MODEL_REVISION \
       SOURCE_MODEL_SUBFOLDER=$SOURCE_MODEL_SUBFOLDER \
       MODEL_DIR=$MODEL_DIR \
       python3 /tmp/build_download.py \
    && rm -rf /root/.cache/huggingface /tmp/build_download.py \
    && chown -R appuser:appuser $MODEL_DIR

# Image-PII V4 detector + zero-text accessibility role-fusion head.
# Baked at build time with pinned commit SHA + SHA-256 verification so the
# enclave measurement is strictly reproducible across rebuilds.
# rfdetr_v108b = 768x768 W16A32 RF-DETR-Nano (52.93 MiB raw / 35.16 MiB gzip)
# pii_role_fusion_v4 = 2.09 MB role/a11y fusion head (~1.4 ms CPU, 0/200 neg FP).
ARG IMAGE_MODELS_REPO=screenpipe/privacy-filter
ARG IMAGE_MODELS_REVISION=6e3d5f7ea20ad43fab39a292c0f273ee13701c62
ARG IMAGE_MODEL_FILE=rfdetr_v108b.onnx
ARG IMAGE_MODEL_SHA256=884018d88343ab1ceb0aeb18f558bc76cac6fb7100f8760cdc28aed809e18dfd
ARG ROLE_MODEL_FILE=pii_role_fusion_v4.onnx
ARG ROLE_MODEL_SHA256=5dec3c65565b1229b40be401fb7246f962a8099694e0cefcf13f04555ca14789
ENV IMAGE_MODEL_PATH=/opt/rfdetr_v108b.onnx \
    IMAGE_MODEL_ID="rfdetr_v108b" \
    ROLE_MODEL_PATH=/opt/pii_role_fusion_v4.onnx \
    ROLE_MODEL_ID="pii_role_fusion_v4"
ADD --checksum=sha256:${IMAGE_MODEL_SHA256} \
    https://raw.githubusercontent.com/${IMAGE_MODELS_REPO}/${IMAGE_MODELS_REVISION}/${IMAGE_MODEL_FILE} \
    ${IMAGE_MODEL_PATH}
ADD --checksum=sha256:${ROLE_MODEL_SHA256} \
    https://raw.githubusercontent.com/${IMAGE_MODELS_REPO}/${IMAGE_MODELS_REVISION}/${ROLE_MODEL_FILE} \
    ${ROLE_MODEL_PATH}
RUN chown appuser:appuser ${IMAGE_MODEL_PATH} ${ROLE_MODEL_PATH}


COPY role_fusion.py server.py test_image_tiling.py test_cpu_mode.py test_role_fusion.py cpu_smoke.py /app/
RUN python3 -m unittest test_cpu_mode test_image_tiling test_role_fusion -v && python3 cpu_smoke.py
USER 10001
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --retries=10 --start-period=120s \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=4)"
CMD ["python3", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
